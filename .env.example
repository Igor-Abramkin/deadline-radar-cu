# Проще всего заполнить через `bun run setup`.

# Telegram: токен от @BotFather, id группы, твой id (сюда бот пишет про сессию LMS)
BOT_TOKEN=
CHAT_ID=
OWNER_ID=
# Тема в группе с темами (из ссылки на сообщение t.me/c/<chat>/<topic>/<msg>); пусто — без темы
THREAD_ID=

# Только для сервера: bff.cookie из data/cookie.txt для первого запуска
CU_COOKIE=

# Необязательно: подставить логин и пароль в форму при `bun run login`
CU_LOGIN=
CU_PASSWORD=

# Необязательно
REMIND_HOURS=72,24,3
POLL_MINUTES=30
LIST_DAYS=14
GROUP_COOLDOWN_SEC=3600
PRIVATE_COOLDOWN_SEC=30
EXCLUDE_COURSES=Ознакомление
TZ_DISPLAY=Europe/Moscow

# Необязательно: конкурс с обратным отсчётом, см. README
CONTEST_URL=
CONTEST_REMIND_HOURS=72,48,24,12,3,1

# LMS account, used only by `pnpm login` to prefill the form
CU_LOGIN=
CU_PASSWORD=

# Telegram: token from @BotFather, group id from /chatid, your user id for session alerts
BOT_TOKEN=
CHAT_ID=
OWNER_ID=
# Forum topic id for group posts (from a message link t.me/c/<chat>/<topic>/<msg>)
THREAD_ID=

# Server only: bff.cookie from data/cookie.txt for the first start
CU_COOKIE=

# Optional
REMIND_HOURS=72,24,3
POLL_MINUTES=30
LIST_DAYS=14
GROUP_COOLDOWN_SEC=300
PRIVATE_COOLDOWN_SEC=30
EXCLUDE_COURSES=Ознакомление
